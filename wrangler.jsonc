{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vranovicke-hody-2026",
  "main": "./src/worker-v12.ts",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "GOOGLE_REFRESH_TOKEN"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vranovicke-hody-2026-db",
      "database_id": "2a47d9c8-8562-4c4b-87d4-7b13b281f158",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "vranovicke-hody-2026-photos"
    }
  ]
}
